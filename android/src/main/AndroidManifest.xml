<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The navigation page is loaded from the network into a WebView. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!--
    Declared here so the host app inherits them, but the host must still
    request the runtime ones before scanning. `neverForLocation` is not set:
    beacon RSSI is used to derive the user's position, which is exactly the
    inference that flag asserts is not happening.
  -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <!-- Pre-31 devices gate BLE scanning on the legacy Bluetooth permissions. -->
  <uses-permission
      android:name="android.permission.BLUETOOTH"
      android:maxSdkVersion="30" />
  <uses-permission
      android:name="android.permission.BLUETOOTH_ADMIN"
      android:maxSdkVersion="30" />

  <uses-feature
      android:name="android.hardware.bluetooth_le"
      android:required="false" />

  <!--
    The page's "Scan nearby QR" opens the camera inside the WebView. Requested
    at runtime the first time the page asks. Not required, so devices without
    a camera can still install the host app.
  -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature
      android:name="android.hardware.camera"
      android:required="false" />

  <!--
    The page's spoken instructions are voiced by the device's text-to-speech
    engine (a WebView has none of its own). From Android 11 an app cannot see
    that engine without declaring the intent it binds to.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>

</manifest>
