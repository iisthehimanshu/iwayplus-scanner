<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The navigation page is loaded from the network into a WebView. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!--
    Declared here so the host app inherits them, but the host must still
    request the runtime ones before scanning. `neverForLocation` is not set:
    beacon RSSI is used to derive the user's position, which is exactly the
    inference that flag asserts is not happening.
  -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <!-- Pre-31 devices gate BLE scanning on the legacy Bluetooth permissions. -->
  <uses-permission
      android:name="android.permission.BLUETOOTH"
      android:maxSdkVersion="30" />
  <uses-permission
      android:name="android.permission.BLUETOOTH_ADMIN"
      android:maxSdkVersion="30" />

  <uses-feature
      android:name="android.hardware.bluetooth_le"
      android:required="false" />

</manifest>
